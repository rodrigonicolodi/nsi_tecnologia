# Modelo do arquivo .env do NSI Tecnologia
# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O .env NUNCA vai para o Git: cada PC e o servidor têm o seu.

# Banco de dados
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sessão (use um texto longo e aleatório; diferente em produção)
SESSION_SECRET=

# Ambiente: development nos PCs, production no servidor
NODE_ENV=development

# Porta do servidor
PORT=3000

# true apenas se o servidor usar HTTPS direto no Node (opcional)
FORCE_SECURE_COOKIE=false
